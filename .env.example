# Use this only if the frontend must call an external backend URL.
# In production, you can leave this blank and the app will call /api from the same host.
VITE_API_URL=
# Example for a separate frontend/backend deployment:
# VITE_API_URL=https://your-backend-url.example.com/api

# When deploying to Render or another host, set the allowed origin for CORS.
# For Render, use your service URL, for example:
# CORS_ORIGIN=https://your-app.onrender.com
